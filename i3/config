# =========================
# i3 CONFIG - Klvn
# =========================

set $mod Mod4

# Font
font pango:Noto Sans 8

# =========================
# INPUT / KEYBOARD
# =========================
exec --no-startup-id setxkbmap -layout br -variant abnt2

# =========================
# AUTOSTART (SYSTEM)
# =========================

# XDG autostart apps
exec --no-startup-id dex --autostart --environment i3

# Compositor / notifications / tray
exec --no-startup-id picom
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id xfce4-clipman
exec --no-startup-id lxqt-policykit-agent

# Wallpaper
exec_always --no-startup-id feh --bg-fill ~/Pictures/Wallpapers/alena-aenami-horizon.png

# Lock screen (sleep handling)
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# =========================
# KEY BINDS - UTILITIES
# =========================

bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun
bindsym Print exec flameshot gui
bindsym $mod+q kill

# Power Menu
bindsym XF86PowerOff exec --no-startup-id ~/.config/i3/power-menu.sh

# =========================
# AUDIO
# =========================

set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause


# =========================
# WINDOW BEHAVIOR
# =========================

floating_modifier $mod
tiling_drag modifier titlebar

for_window [class=".*"] border pixel 2
for_window [class="Yad"] floating enable, resize set 220 120, move position center
default_border pixel 2
default_floating_border pixel 2

gaps inner 4
gaps outer 2

# =========================
# COLORS / THEME
# =========================

set $bg                 #121212
set $fg                 #e6e6e6

set $border_focused     #f0f0f0
set $border_active      #cfcfcf
set $border_inactive    #2b2b2b
set $border_urgent      #ffffff

client.focused          $border_focused   $bg $fg $border_focused  $border_focused
client.focused_inactive $border_inactive  $bg $fg $border_inactive $border_inactive
client.unfocused        $border_inactive  $bg $fg $border_inactive $border_inactive
client.urgent           $border_urgent    $bg $fg $border_urgent   $border_urgent
client.placeholder      $border_inactive  $bg $fg $border_inactive $border_inactive

# =========================
# FOCUS / MOVEMENT
# =========================

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# layout
bindsym $mod+h split toggle
bindsym $mod+F11 fullscreen toggle
bindsym $mod+w layout toggle

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# =========================
# WORKSPACES
# =========================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# =========================
# SYSTEM CONTROLS
# =========================

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# =========================
# RESIZE MODE
# =========================

bindsym $mod+Control+Left resize shrink width 5 px or 5 ppt
bindsym $mod+Control+Down resize grow height 5 px or 5 ppt
bindsym $mod+Control+Up resize shrink height 5 px or 5 ppt
bindsym $mod+Control+Right resize grow width 5 px or 5 ppt
